{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "待办工作台默认权限集",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "sql:allow-close",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "fs:allow-exists",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:allow-write-text-file",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA/**" },
        { "path": "$APPDATA" },
        { "path": "$RESOURCE/**" }
      ]
    },
    "dialog:default",
    "process:default",
    "updater:default"
  ]
}
