{
  "id": "abnormal-ticket",
  "name": "异常单号登记",
  "version": "0.4.0",
  "description": "登记异常单号：记下订单号、店铺、异常内容、类型、等级与处理状态，可一键呼起拼多多商家客户端打开那张订单。多个店铺各配一个客服 ID，按单子所属店铺呼起。数据存在工具自己的表里，与待办数据互不干扰",
  "icon": "receipt",
  "entry": "index.html",
  "dbVersion": 3,
  "author": "内置",
  "schema": {
    "tables": [
      {
        "name": "tickets",
        "columns": [
          { "name": "id", "type": "text", "pk": true },
          { "name": "code", "type": "text" },
          { "name": "order_sn", "type": "text" },
          { "name": "store", "type": "text" },
          { "name": "title", "type": "text" },
          { "name": "category", "type": "text" },
          { "name": "level", "type": "text" },
          { "name": "status", "type": "text" },
          { "name": "reporter", "type": "text" },
          { "name": "occurred_at", "type": "text" },
          { "name": "note", "type": "text" },
          { "name": "created_at", "type": "text" },
          { "name": "updated_at", "type": "text" }
        ],
        "indexes": [{ "columns": ["created_at"] }]
      }
    ]
  }
}
