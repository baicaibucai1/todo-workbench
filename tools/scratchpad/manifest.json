{
  "id": "scratchpad",
  "name": "模板",
  "version": "1.0.0",
  "description": "写工具时照着抄的样板：演示一个工具怎么在工作台里建自己的表、用结构化 CRUD 读写它，以及把一条内容交给别的工具。默认停用，不是日常用的便签本",
  "icon": "notebook-pen",
  "tags": ["template"],
  "entry": "index.html",
  "dbVersion": 1,
  "author": "内置",
  "schema": {
    "tables": [
      {
        "name": "notes",
        "columns": [
          { "name": "id", "type": "text", "pk": true },
          { "name": "title", "type": "text" },
          { "name": "body", "type": "text" },
          { "name": "tag", "type": "text" },
          { "name": "created_at", "type": "text" }
        ],
        "indexes": [{ "columns": ["created_at"] }]
      }
    ]
  }
}
