{
  "id": "abnormal-ticket",
  "name": "异常单号登记",
  "version": "0.8.1",
  "description": "按你的异常登记台账建：快递单号、快递公司、订单发货时间、情况、店铺、订单号、详细描述、处理方式、结果、结账。可一键呼起拼多多商家客户端打开那张订单，多个店铺各配一个客服 ID（在「设置」页粘一条 ERP 链接就能绑），按单子所属店铺呼起。同一订单号重复登记会当场提示。处理进度用「流程状态」记：每一步有名称和时间，最后一步就是当前状态（选项可在设置里改）。还能给单子设提醒——到点后工作台的待办里会多一条带「来自异常单号登记」标记的单子并弹提醒卡。下拉选项都能在设置里改。数据存在工具自己的表里，与待办数据互不干扰",
  "icon": "receipt",
  "entry": "index.html",
  "dbVersion": 6,
  "author": "内置",
  "capabilities": ["task"],
  "schema": {
    "tables": [
      {
        "name": "tickets",
        "columns": [
          { "name": "id", "type": "text", "pk": true },
          { "name": "order_sn", "type": "text" },
          { "name": "tracking_no", "type": "text" },
          { "name": "courier", "type": "text" },
          { "name": "shipped_at", "type": "text" },
          { "name": "store", "type": "text" },
          { "name": "title", "type": "text" },
          { "name": "category", "type": "text" },
          { "name": "handling", "type": "text" },
          { "name": "result", "type": "text" },
          { "name": "settled", "type": "text" },
          { "name": "note", "type": "text" },
          { "name": "flow", "type": "text" },
          { "name": "remind_at", "type": "text" },
          { "name": "remind_task", "type": "text" },
          { "name": "created_at", "type": "text" },
          { "name": "updated_at", "type": "text" }
        ],
        "indexes": [{ "columns": ["created_at"] }]
      }
    ]
  }
}
