{
  "name": "todo-workbench",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "description": "待办工作台 - 以 Microsoft To Do 为原型的可扩展桌面工作台",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "smoke": "esbuild tests/smoke.mjs --bundle --platform=node --format=esm --target=node22 --outfile=tests/.smoke.bundle.mjs --external:jsdom --log-level=warning && node tests/.smoke.bundle.mjs",
    "sync:test": "esbuild tests/sync.mjs --bundle --platform=node --format=esm --target=node22 --outfile=tests/.sync.bundle.mjs --external:jsdom --log-level=warning && node tests/.sync.bundle.mjs",
    "agent:test": "esbuild tests/agent-unit.mjs --bundle --platform=node --format=esm --target=node22 --outfile=tests/.agent-unit.bundle.mjs --external:jsdom --log-level=warning && node tests/.agent-unit.bundle.mjs",
    "agent:author": "node scripts/agent-author.mjs",
    "gomoku:test": "node tests/gomoku-unit.mjs",
    "typecheck": "tsc -b --pretty false",
    "icons": "node scripts/gen-icons.mjs",
    "icons:check": "node tests/icons.mjs",
    "wallpapers": "node scripts/fetch-wallpapers.mjs",
    "webview2:sync": "node scripts/sync-webview2-loader.mjs",
    "webview2:check": "node scripts/sync-webview2-loader.mjs --check",
    "tools:sync": "node scripts/sync-tools.mjs",
    "tools:check": "node scripts/sync-tools.mjs --check",
    "bat:check": "node scripts/bat-lint.mjs",
    "bat:fix": "node scripts/bat-lint.mjs --fix",
    "env:check": "node scripts/env-check.mjs",
    "setup:gnu": "node scripts/setup-gnu.mjs",
    "setup:rust": "node scripts/setup-rust.mjs",
    "setup:msys2": "node scripts/setup-msys2.mjs",
    "setup:mingw": "node scripts/setup-mingw.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:status": "node scripts/build-status.mjs",
    "installer:check": "node scripts/check-installer.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-process": "^2.3.0",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.9.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
