            "type": "text"
          },
          {
            "name": "body",
            "type": "text"
          },
          {
            "name": "tag",
            "type": "text"
          },
          {
            "name": "board",
            "type": "text"
          },
          {
            "name": "x",
            "type": "integer"
          },
          {
            "name": "y",
            "type": "integer"
          },
          {
            "name": "w",
            "type": "integer"
          },
          {
            "name": "h",
            "type": "integer"
          },
          {
            "name": "color",
            "type": "text"
          },
          {
            "name": "z",
            "type": "integer"
          },
          {
            "name": "gallery_id",
            "type": "text"
          },
          {
            "name": "thumb",
            "type": "text"
          },
          {
            "name": "remind_at",
