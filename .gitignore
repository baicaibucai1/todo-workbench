# 依赖与构建产物
node_modules/
dist/
target/
# 工具包 zip —— 由 scripts/pack-tools.mjs 生成，作为独立资产挂在 Release 上。
# 不进仓库的理由与 tools/*/ai/ 一样：体积大且是生成物（约 30 MB 压缩包）。
release-assets/

# 更新清单 —— 由 scripts/publish-release.mjs 每次发版生成（版本号 + 下载 URL + 签名），
# 是**发布产物**不是源码。留在本地给发布脚本与回滚参考，不进仓库
# （曾经误入版本控制，2026-09-26 摘除）。
update.json

# 工具的大体积附属资源 —— 由 scripts/sync-tools.mjs 从源目录搬运过来，
# 不是仓库里的源码：tools/image-crop/ai/ 约 50MB（ONNX Runtime + MI-GAN 模型，
# 全部 base64 塞进 .js 用 script 标签加载，为的是绕开 file:// 下的 fetch 限制）。
# 不进仓库是为了别让公开仓库暴涨；本地打包前跑一次 sync-tools 即可带上。
# 缺失时工具会自己退回纯 JS 补全算法，不会崩。
tools/*/ai/

# Tauri 生成
src-tauri/gen/

# 本机工具链配置 —— 由 scripts/setup-gnu.mjs 生成，内容是本机 MinGW 的绝对路径。
# 提交它有两个坏处：暴露本机用户名与目录结构；别人 clone 之后 cargo 会去找
# 一个不存在的路径，直接构建失败（而报错里根本看不出是"配置来自别人机器"）。
src-tauri/.cargo/config.toml
src-tauri/.cargo/config.toml.bak

# 会话规范与记忆（Tools 顶层有权威副本，不进版本控制）
.workbuddy/

# 本地环境
.env
.env.local

# 编辑器
.vscode/
.idea/
*.swp

# 系统
Thumbs.db
Desktop.ini
.DS_Store

# 本地备份文件
*.bak

# 更新签名私钥 —— 绝对不要提交
*.key
# 注意：Tauri 的私钥文件名就叫 .tauri-key（没有 .key 后缀），
# 上面的 *.key 匹配不到它，必须单独写出来。公钥可以提交。
.tauri-key
.tauri-key.bak

# 本地调试产物：含本机绝对路径、构建与测试日志，与代码无关
.setup-tmp/
probe-result.txt
环境自检报告.txt
*.log
tests/.*.log
tests/.smoke.bundle.mjs
tests/.sync.bundle.mjs
tests/.agent-unit.bundle.mjs
tests/.tsc.log

# e2e 截图：跑测试时抓的界面图，里面有真实待办与流程任务数据，不进仓库
shots/
tests/.shots/
